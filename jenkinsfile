pipeline {
    agent any

    tools {
        jdk 'jdk17'  // 这里填你在 Jenkins Global Tool 中配置的 JDK 名称
        maven 'maven'  // 这里填你在 Jenkins Global Tool 中配置的 Maven 名称
    }

    stages {
        stage('Checkout') {
            steps {
                echo '拉取代码中...'
                // Jenkins 会自动从 Git 拉取代码，无需手动写 checkout
            }
        }

        stage('Compile') {
            steps {
                echo '编译项目...'
                // 1. 声明使用之前配置好的 Maven 工具，并获取其主目录
                script {
                    // 假设你在 Global Tool Configuration 里配置的 Maven 名字叫 'maven' (或者你改成的正确名字)
                    def mavenHome = tool 'maven'
                    // 2. 将 Maven 的 bin 目录临时加入 PATH
                    env.PATH = "${mavenHome}/bin:${env.PATH}"
                }
                // 3. 现在可以直接使用 mvn 命令了
                sh 'mvn clean compile'
            }
        }

        stage('Test') {
            steps {
                echo '运行单元测试...'
                sh 'mvn test'
            }
        }

        stage('Package') {
            steps {
                echo '打包成 Jar...'
                sh 'mvn package -DskipTests'
            }
        }
    }

    post {
        success {
            echo '✅ 构建成功！'
        }
        failure {
            echo '❌ 构建失败！'
        }
    }
}